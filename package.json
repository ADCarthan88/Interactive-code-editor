    "babel-loader": "^9.1.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "css-loader": "^6.8.0",
    "mini-css-extract-plugin": "^2.7.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.6.0",
    "cypress": "^13.0.0",
    "eslint": "^8.45.0"
