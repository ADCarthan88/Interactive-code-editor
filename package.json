{
  "name": "@adcarthan88/interactive-code-editor",
  "version": "2.0.0",
  "description": "Enterprise-grade interactive code editor with AI assistance and real-time collaboration",
  "main": "index.html",
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "start": "python -m http.server 8000",
    "serve": "npx http-server . -p 8000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint src/ js/ --ext .js",
    "lint:fix": "eslint src/ js/ --ext .js --fix",
    "format": "prettier --write \"**/*.{js,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,md}\"",
    "deploy": "npm run build && docker build -t code-editor .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "keywords": [
    "code-editor",
    "javascript",
    "html5",
    "css3",
    "webpack",
    "docker",
    "ai-powered",
    "real-time-collaboration",
    "enterprise",
    "accessibility",
    "syntax-highlighting",
    "web-development"
  ],
  "author": "ADCarthan88",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ADCarthan88/Interactive-code-editor.git"
  },
  "bugs": {
    "url": "https://github.com/ADCarthan88/Interactive-code-editor/issues"
  },
  "homepage": "https://github.com/ADCarthan88/Interactive-code-editor#readme",
  "dependencies": {
    "monaco-editor": "^0.44.0",
    "socket.io-client": "^4.7.2",
    "prettier": "^3.0.3",
    "dompurify": "^3.0.5"
  },
  "devDependencies": {
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.22.20",
    "@babel/preset-env": "^7.22.20",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.7.6",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "cypress": "^13.3.0",
    "eslint": "^8.49.0",
    "@eslint/js": "^8.49.0",
    "eslint-config-prettier": "^9.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}